<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Deliberately empty of the App Sandbox key. This app talks to a vendor
      USB HID interface via raw IOHIDDeviceSetReport feature reports, which
      the sandbox does not reliably permit even with device-usb style
      entitlements on unlisted vendor HID devices. Keep this app un-sandboxed.

      Input Monitoring (System Settings > Privacy & Security > Input
      Monitoring) is a separate, non-entitlement TCC check that macOS applies
      regardless of sandboxing — that's the one this build fixes by giving
      the app a stable, consistent code signature (see build.sh).
    -->
</dict>
</plist>
